# suite-managed (deploy) — regenerated by conform, do not edit by hand.
# Backend ExperienceFinder (experiencefinder). Build context = node root.
#
# TWO STAGES, one image file:
#   dev  — hot reload on, used by deploy/docker-compose.yml (target: dev).
#          backend/ is bind-mounted at runtime, so this image only installs the
#          dependencies and uvicorn --reload watches the mounted code.
#   prod — no reload, no watcher, used by deploy/docker-compose.prod.yml
#          (target: prod). The image IS the source; nothing is mounted over it.
# `dev` is the LAST stage on purpose: a bare `docker build` with no --target
# keeps the hot-reload behaviour, so a node whose compose predates the split
# does not silently get a production image.
FROM python:3.13-slim AS base
# PIP_DEFAULT_TIMEOUT: on slow links (the mini-PC) the default 15s made
# downloads of large wheels fail mid-build.
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DEFAULT_TIMEOUT=300
WORKDIR /app
# build-essential + libpq-dev: several real nodes' requirements.txt pull in
# packages with C extensions that need compiling at install time (psycopg2,
# bcrypt, ortools…) — curl alone left those installs failing on a slim image.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend/ ./backend/
RUN pip install --no-cache-dir /app/backend/vendor/suite-backend-core
# The commit the image was built from, for a health endpoint to report. A
# build-arg, not `COPY .git`: Docker's implicit ignore drops .git from the
# context. deploy/build.sh passes the real SHA; unset it stays "unknown" —
# never a fabricated value. In dev the bind mount hides the file, as it should.
ARG GIT_COMMIT=unknown
RUN echo "$GIT_COMMIT" > backend/.git-commit
WORKDIR /app/backend
ENV PYTHONPATH=/app/backend
ENV PORT=10020
EXPOSE 10020
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:10020/api/health || exit 1

# ---------------------------------------------------------------- prod stage
FROM base AS prod
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn experiencefinder_backend.app:app --host 0.0.0.0 --port 10020"]

# ----------------------------------------------------------------- dev stage
FROM base AS dev
# WATCHFILES_FORCE_POLLING: inotify events do not cross a Windows-hosted bind
# mount, so the default watcher never fires — polling is the only reliable
# change detection there.
# PYTHONPYCACHEPREFIX moves .pyc files OUT of backend/: a stale __pycache__
# left on the host (from pre-Docker native runs) otherwise ends up in the
# bind-mount and Python may execute old bytecode even though WatchFiles
# detects and reloads the updated source (real bug observed: reload fired
# correctly, but the response stayed unchanged until the .pyc expired).
ENV WATCHFILES_FORCE_POLLING=true \
    PYTHONPYCACHEPREFIX=/tmp/pycache
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn experiencefinder_backend.app:app --host 0.0.0.0 --port 10020 --reload --reload-dir /app/backend"]
