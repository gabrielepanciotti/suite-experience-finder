{
  "schemaVersion": "2.0",
  "name": "ExperienceFinder",
  "slug": "experiencefinder",
  "type": "fastapi-react-app",
  "visibility": "public",
  "hostBase": "experiencefinder.life.local",
  "inherits": "../Life/node.config",
  "taxonomy": {
    "id": "experienceFinder",
    "cluster": [
      "Travel"
    ],
    "displayName": "ExperienceFinder",
    "commercial": false
  },
  "brain_profile": "standard",
  "tooling": {
    "grants": [
      { "kind": "mcp-toolset", "ref": "graph,brain", "scope": "self" },
      { "kind": "mcp-toolset", "ref": "db,brain", "scope": "subtree" }
    ],
    "deny": [],
    "subagents": {
      "api-reviewer": { "toolsets": ["db"], "readOnly": true },
      "ui-reviewer": { "toolsets": ["brain"], "readOnly": true }
    }
  },
  "capabilities": ["build", "test", "deploy"],
  "agents": {
    "archetypes": []
  },
  "mcp": {
    "toolsets": ["graph", "brain", "db"],
    "readOnly": true
  },
  "deploy": {
    "appModule": "experiencefinder_backend.app:app",
    "migrations": true,
    "database": {
      "name": "experiencefinder",
      "user": "experiencefinder",
      "host": "experiencefinder-db",
      "driver": "postgresql+asyncpg"
    }
  },
  "children": []
}
