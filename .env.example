# PostgreSQL connection used by the API and the example Docker Compose stack.
DB_PASSWORD=change-me
DB_HOST_PORT=5432

# Optional: filesystem location of the Markdown vault for a native backend run.
# VAULT_DIR=./vault
# VAULT_IMPORT_ON_STARTUP=1

# Optional: URL used by the Vite development proxy.
# VITE_BACKEND_PROXY_TARGET=http://localhost:10020
